---
import { Icon } from 'astro-icon/components';
import type { I18n } from '../../i18n/pt';
interface Props { t: I18n }
const { t } = Astro.props;
---

<section id="contato" tabindex="-1" aria-labelledby="contact-heading">
  <div class="container contact-panel">
    <div>
      <h2 id="contact-heading" data-i18n="contact.heading">{t.contact.heading}</h2>
      <p class="section-intro" data-i18n="contact.intro">{t.contact.intro}</p>
    </div>
    <div class="actions">
      <a class="button" href="https://www.linkedin.com/in/lucianocvn" target="_blank" rel="noopener noreferrer"><span data-i18n="contact.action">{t.contact.action}</span><Icon name="lucide:arrow-up-right" width="18" height="18" aria-hidden="true" /></a>
      <a class="text-link" href="https://github.com/lucianovianna" target="_blank" rel="noopener noreferrer">GitHub<Icon name="lucide:arrow-up-right" width="18" height="18" aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
#contato { padding-top: 0; }
.contact-panel { padding: 2rem; background: var(--color-soft); border-radius: var(--radius); display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
h2 { font-size: 1.8rem; }
.section-intro { font-size: 0.9rem; max-width: 48ch; }
.actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; flex-shrink: 0; }
@media (max-width: 899px) { .contact-panel { align-items: flex-start; flex-direction: column; gap: 1.5rem; } }
@media (max-width: 599px) { .contact-panel { padding: 1.5rem; } .actions { flex-shrink: 1; } }
@media (max-width: 359px) { .actions { width: 100%; } .button { width: 100%; font-size: 0.85rem; justify-content: space-between; } }
</style>
