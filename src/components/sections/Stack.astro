---
import type { I18n } from '../../i18n/pt';
interface Props { t: I18n }
const { t } = Astro.props;

const stackData = {
  backend: ['Laravel (PHP)', 'NestJS', 'Node.js'],
  database: ['PostgreSQL', 'Redis', 'Supabase'],
  frontend: ['Vue.js', 'TypeScript', 'Astro'],
  devops: ['AWS', 'Docker', 'GitHub Actions'],
};
---

<section id="stack">
  <div class="container">
    <div class="fade-in">
      <h2 data-i18n="stack.heading">{t.stack.heading}</h2>
      <div class="categories">
        {Object.entries(stackData).map(([key, items]) => (
          <div class="category">
            <h3 data-i18n={`stack.categories.${key}`}>{t.stack.categories[key as keyof typeof t.stack.categories]}</h3>
            <ul>
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
h2 {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 2rem;
}

.categories {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 2rem;
}

h3 {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-muted);
  margin-bottom: 0.75rem;
}

ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

li {
  font-size: 0.95rem;
}
</style>
