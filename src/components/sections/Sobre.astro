---
import type { I18n } from '../../i18n/pt';
interface Props { t: I18n }
const { t } = Astro.props;
---

<section id="sobre" tabindex="-1" aria-labelledby="about-heading">
  <div class="container about-layout">
    <div class="bio">
      <h2 id="about-heading" data-i18n="about.heading">{t.about.heading}</h2>
      {t.about.bio.map((p, i) => <p data-i18n={`about.bio.${i}`}>{p}</p>)}
    </div>
    <dl class="results">
      {t.about.results.map((result, i) => (
        <div class="result">
          <dt data-i18n={`about.results.${i}.value`}>{result.value}</dt>
          <dd data-i18n={`about.results.${i}.label`}>{result.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
.about-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; }
.bio h2 { max-width: 18ch; }
.bio p { color: var(--color-muted); font-size: 0.95rem; margin-top: 1rem; }
.results { border-left: 1px solid var(--color-border); padding-left: 2.5rem; }
.result { display: grid; grid-template-columns: minmax(150px, 0.9fr) minmax(0, 1.3fr); gap: 1.5rem; padding-block: 1rem; align-items: start; }
.result + .result { border-top: 1px solid var(--color-border); }
dt { font-size: clamp(1.5rem, 2.8vw, 2rem); line-height: 1.25; font-weight: 700; color: var(--color-accent); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; white-space: nowrap; }
dd { font-size: 0.85rem; color: var(--color-muted); }
@media (max-width: 899px) { .about-layout { gap: 2rem; } .results { padding-left: 1.5rem; } .result { grid-template-columns: 1fr; gap: 0.5rem; } }
@media (max-width: 599px) { .about-layout { grid-template-columns: 1fr; } .results { border-left: 0; padding-left: 0; } .result { grid-template-columns: minmax(120px, 0.9fr) minmax(0, 1.1fr); gap: 1rem; } }
</style>
