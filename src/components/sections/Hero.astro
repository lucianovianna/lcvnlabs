---
import { Icon } from 'astro-icon/components';
import type { I18n } from '../../i18n/pt';
interface Props { t: I18n }
const { t } = Astro.props;
---

<section id="hero" aria-labelledby="hero-title">
  <div class="container hero-layout">
    <div class="hero-content">
      <p class="role" data-i18n="hero.role">{t.hero.role}</p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="tagline" data-i18n="hero.tagline">{t.hero.tagline}</p>
      <div class="actions">
        <a class="button" href="#projetos"><span data-i18n="hero.action">{t.hero.action}</span><Icon name="lucide:arrow-down" width="17" height="17" aria-hidden="true" /></a>
        <a class="text-link" href="https://www.linkedin.com/in/lucianocvn" target="_blank" rel="noopener noreferrer">LinkedIn<Icon name="lucide:arrow-up-right" width="18" height="18" aria-hidden="true" /></a>
      </div>
    </div>
    <aside class="specialty">
      <h2 data-i18n="hero.focus">{t.hero.focus}</h2>
      <p class="technologies">Laravel / PostgreSQL / Vue.js</p>
      <p data-i18n="hero.context">{t.hero.context}</p>
    </aside>
  </div>
</section>

<style>
#hero { padding-block: 4rem; border-bottom: 1px solid var(--color-border); }
.hero-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
.role { font-size: 0.85rem; font-weight: 600; color: var(--color-accent); margin-bottom: 0.75rem; }
h1 { font-size: clamp(2.65rem, 6.7vw, 5rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.04em; }
.tagline { font-size: clamp(1.35rem, 3.4vw, 2rem); line-height: 1.35; letter-spacing: -0.025em; color: var(--color-muted); max-width: 34ch; margin-top: 1rem; }
.actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.5rem; }
.specialty { border-top: 2px solid var(--color-border); padding-top: 1.25rem; margin-top: 1.5rem; }
.specialty h2 { font-size: 1.25rem; letter-spacing: -0.03em; }
.specialty p { color: var(--color-muted); font-size: 0.9rem; margin-top: 0.65rem; }
.specialty .technologies { font-size: 0.95rem; }
@media (max-width: 767px) {
  #hero { padding-block: 3rem; }
  .hero-layout { grid-template-columns: 1fr; gap: 2.5rem; }
  .specialty { margin-top: 0; max-width: 28rem; }
  .specialty h2 { font-size: 1.1rem; }
  .role { max-width: 32ch; }
}
@media (max-width: 359px) { h1 { font-size: 2.4rem; } .actions { gap: 0.75rem; } }
</style>
