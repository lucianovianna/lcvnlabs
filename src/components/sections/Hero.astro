---
import type { I18n } from '../../i18n/pt';
interface Props { t: I18n }
const { t } = Astro.props;
---

<section id="hero">
  <div class="container">
    <div class="fade-in hero-content">
      <h1>{t.hero.title}</h1>
      <p class="role">{t.hero.role}</p>
      <p class="tagline">{t.hero.tagline}</p>
      <div class="links">
        <a href="https://github.com/lucianovianna" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/lucianovianna" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
#hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

h1 {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  line-height: 1.1;
}

.role {
  font-size: 1.125rem;
  color: var(--color-accent);
  font-weight: 500;
}

.tagline {
  font-size: 1.1rem;
  color: var(--color-muted);
  max-width: 520px;
}

.links {
  display: flex;
  gap: 1.25rem;
  margin-top: 0.5rem;
}

.links a {
  font-weight: 500;
  font-size: 0.95rem;
}
</style>
